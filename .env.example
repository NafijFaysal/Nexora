# What If? - example configuration
#
# This file is a template and is safe to commit. It must contain
# placeholders only, never real secrets.
#
# How to use it (once the backend and frontend folders exist):
#   backend/.env         <- copy the "Backend" section here
#   frontend/.env.local  <- copy the "Frontend" section here
# Both real files are ignored by Git.

# ----- Backend (FastAPI) -----

# Where the SQLite journal database is stored. A local file keeps hosting cost at zero.
DATABASE_URL=sqlite:///./whatif.db

# Browser origins allowed to call the API (comma-separated). Keep this narrow.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Master switch for optional AI-assisted input parsing.
# Leave false unless you deliberately set up a key; the app is fully usable without AI.
AI_PARSING_ENABLED=false

# Only needed when AI_PARSING_ENABLED=true. Leave empty otherwise.
# API usage is billed separately from a Claude chat subscription; check current pricing first.
ANTHROPIC_API_KEY=

# Model identifier for AI parsing. Copy a current value from Anthropic's documentation.
AI_MODEL=

# Upper bound on text sent to the AI parser, to limit cost and abuse.
AI_MAX_INPUT_CHARS=4000

# ----- Frontend (Next.js) -----

# Base URL of the backend API. NEXT_PUBLIC_ values are visible in the browser,
# so never put a secret in a variable with this prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
