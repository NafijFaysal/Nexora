# ---------------------------------------------------------------
# Secrets and local configuration
# Real keys live only in untracked .env files. Never commit them.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------
# Node.js / Next.js
# package-lock.json is intentionally NOT ignored: commit it so
# installs are reproducible.
# ---------------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vercel/
.turbo/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------
# Test artifacts
# ---------------------------------------------------------------
playwright-report/
test-results/

# ---------------------------------------------------------------
# Local data and generated output
# The journal database is personal data; keep it out of Git.
# ---------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
/exports/
*.log

# ---------------------------------------------------------------
# Editors and operating system
# ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
